# ==========================================
# UniBridge · Apache Production Configuration
# ==========================================

# Set default index order
DirectoryIndex index.php index.html

# Disable directory browsing
Options -Indexes

# Follow symbolic links if needed
Options +FollowSymLinks

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block sensitive files from direct web access
<FilesMatch "(^\.env|^\.git|\.sql$|Dockerfile|docker-compose.*\.ya?ml$|\.log$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# PHP Execution & Upload limits (if mod_php is active)
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value memory_limit 256M
    php_value max_execution_time 60
    php_flag display_errors Off
</IfModule>
