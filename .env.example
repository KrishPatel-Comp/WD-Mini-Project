# ==========================================
# UniBridge · Environment Configuration Template
# Copy this file to .env before starting containers:
#   cp .env.example .env
# ==========================================

# Application Port (Host port mapped to container port 80)
APP_PORT=8080

# Database Settings
DB_HOST=db
DB_PORT=3306
DB_NAME=unibridge
DB_USER=unibridge
DB_PASSWORD=unibridge_secret_pass
DB_ROOT_PASSWORD=root_secure_pass

# phpMyAdmin Port (Optional database GUI)
PMA_PORT=8081
